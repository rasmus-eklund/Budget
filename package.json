{
  "name": "budget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbopack",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "next start",
    "test": "bun run test:unit && bun run test:db",
    "test:watch": "bun run test:unit --watch",
    "test:unit": "bun test $(find src -type f \\( -name '*.test.ts' -o -name '*.test.tsx' -o -name '*.spec.ts' -o -name '*.spec.tsx' \\) ! -name '*.db.test.ts')",
    "test:db": "sh ./scripts/run-integration-tests.sh",
    "validate": "bun run format:check && bun run lint"
  },
