{
  "name": "budget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --turbopack",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "hooks:install": "git config core.hooksPath .githooks",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "next start",
    "test": "bun run test:unit && bun run test:db",
    "test:watch": "bun run test:unit --watch",
    "test:unit": "bun test $(find src -type f \\( -name '*.test.ts' -o -name '*.test.tsx' -o -name '*.spec.ts' -o -name '*.spec.tsx' \\) ! -name '*.db.test.ts')",
    "test:db": "sh ./scripts/run-integration-tests.sh",
    "validate": "bun run format:check && bun run lint",
    "type-check": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^0.7.0",
    "@base-ui/react": "^1.9.0",
    "@hookform/error-message": "^2.0.1",
    "@hookform/resolvers": "^3.10.0",
    "@kinde-oss/kinde-auth-nextjs": "^2.13.2",
    "@t3-oss/env-nextjs": "^0.9.2",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "csv-parse": "^5.6.0",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.542.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "papaparse": "^5.7.0",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-virtuoso": "^4.18.19",
    "recharts": "^2.15.4",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
